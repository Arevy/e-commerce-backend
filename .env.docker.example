# Standalone container. Use credentials for an existing ShopX schema.
PORT=4000
DB_USER=replace-with-existing-schema-user
DB_PASSWORD=replace-with-existing-schema-password
DB_CONNECT_STRING=host.docker.internal:1521/ORCLCDB
JWT_SECRET=replace-with-random-private-secret
REDIS_URL=redis://host.docker.internal:6379/1
REDIS_DISABLED=false
PUBLIC_ASSET_BASE_URL=http://localhost:4000

# Override host ports when another stack already occupies the defaults.
BIND_ADDRESS=127.0.0.1
APP_PORT=4000
