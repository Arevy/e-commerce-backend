# Standalone host process. Use credentials for an existing ShopX schema.
PORT=4000
DB_USER=replace-with-existing-schema-user
DB_PASSWORD=replace-with-existing-schema-password
DB_CONNECT_STRING=127.0.0.1:1521/ORCLCDB
JWT_SECRET=replace-with-random-private-secret
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_DISABLED=false
PUBLIC_ASSET_BASE_URL=http://localhost:4000
